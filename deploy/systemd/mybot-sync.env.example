# ==============================================================================
# /etc/mybot-sync/config.env
# Configuration for Rakazo Self-Hosted Upstream Synchronisation
# Permissions MUST be restricted: chmod 600 /etc/mybot-sync/config.env
# ==============================================================================

# Target Git repository paths
REPO_DIR=/opt/mybot
UPSTREAM_URL=https://github.com/elie222/rakazo.git
FORK_REPO=samansalari/mybot
TARGET_BRANCH=main
INTEGRATION_BRANCH=sync/upstream-integration

# State and Logging directories
STATE_DIR=/var/lib/mybot-sync
STATE_FILE=/var/lib/mybot-sync/state.json
LOG_FILE=/var/log/mybot-sync/sync.log
LOCK_FILE=/tmp/mybot-upstream-sync.lock

# Validation configuration (runs pnpm checks, pnpm check, and test suites)
VALIDATION_ENABLED=true

# Authentication:
# Option A: SSH deploy key (recommended for VPS)
#   Ensure the mybot-sync user has an SSH key registered on GitHub with write access.
#   GIT_SSH_COMMAND="ssh -i /etc/mybot-sync/deploy_key -o IdentitiesOnly=yes"

# Option B: Fine-grained GitHub Personal Access Token (PAT) for PR creation & push
#   Ensure the token has Contents (read/write) and Pull Requests (read/write).
# GH_TOKEN=github_pat_xxxx
